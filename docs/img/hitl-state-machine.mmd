flowchart TD
  S((start)) --> I[Initialized] --> R[Running]
  R -->|consequential action| D{Awaiting decision}
  D -->|accept| R
  D -->|revise with new hash| R
  D -->|decline| X[Declined]
  D -->|cancel| C[Cancelled]
  R -->|crash / timeout| Y[Recovery]
  Y -->|reconcile / resume| R
  Y -->|retry exhausted| B[Blocked]
  R -->|stages complete| L{Awaiting release}
  L -->|accepted authorization| O[Completed]
  L -->|decline| X
  X --> Z((end))
  C --> Z
  B --> Z
  O --> Z
  classDef active fill:#0B2742,color:#fff,stroke:#2DA89C,stroke-width:2px;
  classDef gate fill:#E8F7F5,color:#0B2742,stroke:#2DA89C,stroke-width:2px;
  class I,R,Y,O active;
  class D,L,X,C,B gate;
